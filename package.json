{
  "name": "tailbrowser",
  "version": "0.3.0",
  "description": "Let AI agents control your real Chrome over your tailnet — scoped to pages you allow or the whole browser",
  "type": "module",
  "bin": {
    "tailbrowser": "./agent/tailbrowser.mjs"
  },
  "main": "./agent/index.mjs",
  "exports": {
    ".": "./agent/index.mjs",
    "./mcp": "./agent/tailbrowser.mcp.mjs"
  },
  "files": [
    "agent/",
    "lib/",
    "relay/",
    "extension/",
    "README.md"
  ],
  "scripts": {
    "start:relay": "node relay/relay.mjs",
    "test": "node scripts/stability-test.mjs",
    "test:extension": "node scripts/extension-test.mjs",
    "smoke": "bash scripts/smoke.sh",
    "stability": "node scripts/stability-test.mjs"
  },
  "keywords": [
    "tailscale",
    "playwright",
    "cdp",
    "browser-automation",
    "mcp",
    "ai-agents",
    "chrome"
  ],
  "license": "MIT",
  "dependencies": {
    "playwright-core": "^1.50.0",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=18"
  }
}
