{
  "manifest_version": 3,
  "name": "tailbrowser",
  "version": "0.1.0",
  "description": "Let AI agents on your tailnet control this Chrome — scoped to pages you allow or the whole browser.",
  "minimum_chrome_version": "116",
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html" },
  "permissions": ["debugger", "tabs", "storage"],
  "host_permissions": ["ws://*/*", "wss://*/*", "http://*/*", "https://*/*"],
  "icons": {}
}
