{
  "manifest_version": 3,
  "name": "tailbrowser",
  "version": "0.3.0",
  "description": "Let AI agents on your tailnet control this Chrome — scoped to pages you allow or the whole browser.",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "tailbrowser",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": [
    "debugger",
    "tabs",
    "storage",
    "offscreen",
    "alarms"
  ],
  "host_permissions": [
    "ws://*/*",
    "wss://*/*",
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
